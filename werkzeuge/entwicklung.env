# Umgebung für die lokale Entwicklung (docs/entwicklung.md), nie im Betrieb verwenden.
# Laden in der Shell:  set -a; . werkzeuge/entwicklung.env; set +a
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-nicht-fuer-produktion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_HOST=localhost
POSTGRES_DB=teamplaner
POSTGRES_USER=teamplaner
POSTGRES_PASSWORD=teamplaner-dev
TEAMPLANER_STATIC_MANIFEST=0
TEAMPLANER_ADRESSE=http://localhost:8000
# Ohne EMAIL_HOST wird nichts verschickt. Zum Ansehen der Mails z. B. Mailpit lokal starten
# (Web-Oberfläche http://localhost:8025) und die drei Zeilen aktivieren:
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=0
