# Teamplaner – Konfiguration (/etc/teamplaner/teamplaner.env)
# Gelesen von den systemd-Diensten und dem Befehl teamplaner. Format: SCHLUESSEL=Wert, eine Zeile je
# Wert, keine Leerzeichen um das „=“. Nach Änderungen: sudo teamplaner neustart
# Datei enthält Passwörter: Eigentümer root, Gruppe teamplaner, Rechte 0640.

# --- Adresse ---------------------------------------------------------------------------------------
# Domain ohne https://, mehrere durch Komma getrennt
DJANGO_ALLOWED_HOSTS=teamplaner.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://teamplaner.example.org
# Adresse für Links in E-Mails
TEAMPLANER_ADRESSE=https://teamplaner.example.org

# --- Sicherheit ------------------------------------------------------------------------------------
# Wird bei der Installation automatisch erzeugt; geheim halten, nicht ändern (sonst sind alle abgemeldet)
DJANGO_SECRET_KEY=wird-bei-der-installation-erzeugt
DJANGO_DEBUG=0
# Angemeldet bleiben bis so viele Tage nach der Anmeldung; Admins zusätzlich nach Minuten ohne Aktivität abmelden
TEAMPLANER_SITZUNG_TAGE=30
TEAMPLANER_ADMIN_INAKTIV_MINUTEN=60
TEAMPLANER_FEHLVERSUCHE=5
TEAMPLANER_SPERRE_MINUTEN=15
# Zusätzlich: Fehlversuche je IP-Adresse über alle Konten, dann Sperre der Adresse (0 = aus)
TEAMPLANER_FEHLVERSUCHE_JE_IP=20
# Einladungslinks gelten Tage, Links zum Zurücksetzen eines Passworts nur Stunden
TEAMPLANER_LINK_GUELTIG_TAGE=7
TEAMPLANER_RESET_GUELTIG_STUNDEN=2
# Löschfristen: Protokolle/Benachrichtigungen nach Tagen (Protokoll mindestens 365),
# persönliche Daten deaktivierter Konten nach Tagen (Name, Kommentare, Anhänge bleiben)
TEAMPLANER_AUFBEWAHRUNG_TAGE=365
TEAMPLANER_DEAKTIVIERT_TAGE=90

# --- Datenbank (PostgreSQL ab Version 14) ----------------------------------------------------------
# POSTGRES_HOST: Rechnername/IP, oder ein Socket-Verzeichnis wie /var/run/postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=teamplaner
POSTGRES_USER=teamplaner
POSTGRES_PASSWORD=bitte-eintragen

# --- E-Mail (SMTP) ---------------------------------------------------------------------------------
# Leer lassen = kein Versand (Einladungs- und Reset-Links lassen sich dann nur kopieren)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 = STARTTLS, 465 = SSL
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Teamplaner <teamplaner@example.org>

# --- Anwendungsserver (hinter nginx/Apache) --------------------------------------------------------
# Adresse und Port, auf denen die Anwendung lokal lauscht; der Webserver leitet dorthin weiter
TEAMPLANER_HOST=127.0.0.1
TEAMPLANER_PORT=8000
# IP-Adressen des Webservers, dessen X-Forwarded-*-Kopfzeilen vertraut wird
TEAMPLANER_PROXY_IPS=127.0.0.1
UVICORN_WORKERS=2

# --- Daten und Sicherung ---------------------------------------------------------------------------
# Feste Pfade (von den systemd-Diensten so freigegeben); bei Bedarf dort Speicher einhängen
TEAMPLANER_MEDIA_ROOT=/var/lib/teamplaner/medien
BACKUP_ZIEL=/var/backups/teamplaner
MEDIEN_VERZEICHNIS=/var/lib/teamplaner/medien
# Sicherungen älter als so viele Tage werden gelöscht; Uhrzeit: systemctl edit teamplaner-sicherung.timer
BACKUP_TAGE=30
# Anhänge; der Webserver muss etwas mehr zulassen (nginx client_max_body_size, Apache LimitRequestBody)
TEAMPLANER_ANHANG_MAX_MB=25

# Keine Paketquelle für Container: Updates kommen als Archiv über teamplaner update
TEAMPLANER_IMAGE=
