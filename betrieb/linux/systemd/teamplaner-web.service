# Vorlage: @PROGRAMM@, @KONFIG@, @DATEN@ und @SICHERUNGEN@ setzt teamplaner beim Installieren
# und bei Updates aus der Konfiguration ein (einheiten_installieren).
[Unit]
Description=Teamplaner – Webanwendung
Documentation=file://@PROGRAMM@/aktuell/INSTALLATION.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=teamplaner
Group=teamplaner
EnvironmentFile=@KONFIG@
Environment=TEAMPLANER_MEDIA_ROOT=@DATEN@/medien
WorkingDirectory=@PROGRAMM@/aktuell
ExecStart=@PROGRAMM@/aktuell/betrieb/linux/web.sh
Restart=on-failure
RestartSec=5
# Offene Live-Verbindungen (SSE) werden nach 10 s beendet
TimeoutStopSec=20
UMask=0027
# Härtung: Code und System nur lesbar, schreiben nur im Datenverzeichnis
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@DATEN@

[Install]
WantedBy=multi-user.target
