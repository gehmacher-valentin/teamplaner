[Unit]
Description=Teamplaner – Sicherung von Datenbank und Anhängen
Documentation=file:///opt/teamplaner/aktuell/INSTALLATION.md
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=teamplaner
Group=teamplaner
EnvironmentFile=/etc/teamplaner/teamplaner.env
WorkingDirectory=/opt/teamplaner/aktuell
ExecStart=/opt/teamplaner/aktuell/betrieb/linux/sicherung.sh jetzt
# Sicherungen enthalten alle Daten: nur für den Dienstbenutzer lesbar
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/backups/teamplaner
