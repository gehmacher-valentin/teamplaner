# Vorlage: @PROGRAMM@, @KONFIG@, @DATEN@ und @SICHERUNGEN@ setzt teamplaner beim Installieren
# und bei Updates aus der Konfiguration ein (einheiten_installieren).
[Unit]
Description=Teamplaner – Sicherung von Datenbank und Anhängen
Documentation=file://@PROGRAMM@/aktuell/INSTALLATION.md
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=teamplaner
Group=teamplaner
EnvironmentFile=@KONFIG@
Environment=BACKUP_ZIEL=@SICHERUNGEN@ MEDIEN_VERZEICHNIS=@DATEN@/medien
WorkingDirectory=@PROGRAMM@/aktuell
ExecStart=@PROGRAMM@/aktuell/betrieb/linux/sicherung.sh jetzt
# Sicherungen enthalten alle Daten: nur für den Dienstbenutzer lesbar
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=@SICHERUNGEN@
