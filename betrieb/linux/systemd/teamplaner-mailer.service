# Vorlage: @PROGRAMM@, @KONFIG@, @DATEN@ und @SICHERUNGEN@ setzt teamplaner beim Installieren
# und bei Updates aus der Konfiguration ein (einheiten_installieren).
[Unit]
Description=Teamplaner – Versand der E-Mail-Benachrichtigungen
Documentation=file://@PROGRAMM@/aktuell/INSTALLATION.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=teamplaner
Group=teamplaner
EnvironmentFile=@KONFIG@
Environment=TEAMPLANER_MEDIA_ROOT=@DATEN@/medien
# Meldungen sofort ins Journal: ohne Terminal puffert Python stdout sonst blockweise
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@PROGRAMM@/aktuell
ExecStart=@PROGRAMM@/aktuell/venv/bin/python manage.py mails_versenden --dauerhaft
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@DATEN@

[Install]
WantedBy=multi-user.target
