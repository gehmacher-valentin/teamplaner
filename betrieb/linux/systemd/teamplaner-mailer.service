[Unit]
Description=Teamplaner – Versand der E-Mail-Benachrichtigungen
Documentation=file:///opt/teamplaner/aktuell/INSTALLATION.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=teamplaner
Group=teamplaner
EnvironmentFile=/etc/teamplaner/teamplaner.env
WorkingDirectory=/opt/teamplaner/aktuell
ExecStart=/opt/teamplaner/aktuell/venv/bin/python manage.py mails_versenden --dauerhaft
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/teamplaner

[Install]
WantedBy=multi-user.target
