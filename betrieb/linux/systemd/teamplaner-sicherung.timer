# Vorlage: @PROGRAMM@, @KONFIG@, @DATEN@ und @SICHERUNGEN@ setzt teamplaner beim Installieren
# und bei Updates aus der Konfiguration ein (einheiten_installieren).
[Unit]
Description=Teamplaner – wöchentliche Sicherung
Documentation=file://@PROGRAMM@/aktuell/INSTALLATION.md

[Timer]
# Uhrzeit ändern: sudo systemctl edit teamplaner-sicherung.timer
# Jeden Sonntag
OnCalendar=Sun *-*-* 02:30:00
# Nach einer Abschaltung zur geplanten Zeit beim Hochfahren nachholen
Persistent=true

[Install]
WantedBy=timers.target
