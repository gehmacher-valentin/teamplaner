# Vorlage für die Produktions-/Testumgebung. Kopieren nach .env und Werte anpassen.
# .env niemals ins Repository einchecken.

COMPOSE_PROJECT_NAME=teamplaner

# Installierte Version – setzt ./teamplaner update selbst
TEAMPLANER_VERSION=latest
# Paketquelle
TEAMPLANER_IMAGE=ghcr.io/gehmacher-valentin/teamplaner-app
# Optional: Lesezugang zur Paketquelle, damit Admins in den Einstellungen „Neue Version verfügbar“ sehen
REGISTRY_BENUTZER=
REGISTRY_TOKEN=

# Adresse, unter der das System erreichbar ist (ohne https://)
TEAMPLANER_DOMAIN=teamplaner.example.org
# auto = Let's Encrypt (öffentlich erreichbar), intern = selbst signiert (nur intern erreichbar)
TLS_ART=auto
HTTP_PORT=80
HTTPS_PORT=443

# Django
DJANGO_SECRET_KEY=bitte-durch-langen-zufallswert-ersetzen
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=teamplaner.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://teamplaner.example.org

# Datenbank
POSTGRES_DB=teamplaner
POSTGRES_USER=teamplaner
POSTGRES_PASSWORD=bitte-langes-zufallspasswort

# Anmeldung und Sitzung
# Angemeldet bleiben bis so viele Tage nach der Anmeldung; Admins zusätzlich nach Minuten ohne Aktivität abmelden
TEAMPLANER_SITZUNG_TAGE=30
TEAMPLANER_ADMIN_INAKTIV_MINUTEN=60
TEAMPLANER_FEHLVERSUCHE=5
TEAMPLANER_SPERRE_MINUTEN=15
# Zusätzlich: Fehlversuche je IP-Adresse über alle Konten, dann Sperre der Adresse (0 = aus)
TEAMPLANER_FEHLVERSUCHE_JE_IP=20
# Einladungslinks gelten Tage, Links zum Zurücksetzen eines Passworts nur Stunden
TEAMPLANER_LINK_GUELTIG_TAGE=7
TEAMPLANER_RESET_GUELTIG_STUNDEN=2
# Löschfristen: Protokolle/Benachrichtigungen nach Tagen (Protokoll mindestens 365),
# persönliche Daten deaktivierter Konten nach Tagen (Name, Kommentare, Anhänge bleiben)
TEAMPLANER_AUFBEWAHRUNG_TAGE=365
TEAMPLANER_DEAKTIVIERT_TAGE=90

# E-Mail (SMTP) für Einladungen, Passwort-Reset und Benachrichtigungen.
# Leer lassen = kein E-Mail-Versand (Links werden dann nur angezeigt).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 = STARTTLS (Standard), 465 = SSL
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Teamplaner <teamplaner@example.org>
# Adresse für Links in E-Mails
TEAMPLANER_ADRESSE=https://teamplaner.example.org

# Anhänge
TEAMPLANER_ANHANG_MAX_MB=25

# Backup: jeden Sonntag um BACKUP_UHRZEIT, ältere als BACKUP_TAGE werden gelöscht
BACKUP_UHRZEIT=02:30
BACKUP_TAGE=30
BACKUP_VERZEICHNIS=./backups

# Worker-Prozesse des Anwendungsservers
UVICORN_WORKERS=2

# Nur für Test- und Demo-Installationen: erlaubt "python manage.py demodaten" (leert mit --neu die
# ganze Datenbank und legt Konten mit bekanntem Passwort an). Im Produktivbetrieb immer 0.
TEAMPLANER_DEMO=0
# Passwort aller Demokonten (Standard Teamplaner-Demo-2026)
#DEMO_PASSWORT=
